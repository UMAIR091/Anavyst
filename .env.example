# ─── Supabase (required) ───
# Create a project at https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."
SUPABASE_SERVICE_ROLE_KEY="ey..."     # server-only; never expose to the browser

# ─── App ───
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TOKEN_ENCRYPTION_KEY=""                # 32-byte base64 key for encrypting stored OAuth tokens

# ─── Google OAuth + APIs (required for data sources) ───
# Google Cloud Console → create OAuth client (Web), enable Search Console API + GA4 Data API.
# Google's OAuth consent screen needs verification before public use (can take days).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/google/callback"

# ─── Google Ads API ───
# Reuses the Google OAuth app above (adds the adwords scope at connect time).
# Access belongs to that app's Google Cloud project: see its Google Ads API
# overview page in Cloud Console. Real (non-test) accounts need Explorer access or higher.
# Developer tokens were sunset on 2026-09-09. One is still sent if set, but the API ignores it.
GOOGLE_ADS_DEVELOPER_TOKEN=""
# Manager (MCC) access is resolved per ad account, so there is no login customer id to set.
# Optional: override the API version (defaults to v25; Google retires versions about yearly).
GOOGLE_ADS_API_VERSION=""

# ─── Google Business Profile ───
# No extra env vars — reuses the Google OAuth app (business.manage scope).
# In Google Cloud, enable: My Business Account Management API, My Business
# Business Information API, Business Profile Performance API. Note: Google
# gates GBP API access behind a request form (search "Business Profile API
# access request"); until approved these calls return PERMISSION_DENIED.

# ─── Meta (Facebook + Instagram) OAuth + Graph API ───
# One Meta app powers BOTH Meta Ads and Instagram — no extra env vars for Instagram.
# developers.facebook.com → create an app (type "Business") → add "Facebook Login"
# and the "Marketing API" products. Under Facebook Login → Settings, add the redirect
# URI below to "Valid OAuth Redirect URIs".
# Meta Ads requests: ads_read + business_management.
# Instagram requests: instagram_basic + instagram_manage_insights + pages_show_list
#   + pages_read_engagement + business_management (professional IG account linked
#   to a Facebook Page required).
# In Dev Mode add yourself as a Tester, or submit for App Review to use with other users.
META_APP_ID=""
META_APP_SECRET=""
META_OAUTH_REDIRECT_URI="http://localhost:3000/api/meta/callback"
# Optional: override the Graph API version (defaults to v21.0).
META_API_VERSION=""

# ─── Shopify ───
# partners.shopify.com → create an app (or a custom app) → API credentials.
# Allowed redirection URL: <APP_URL>/api/shopify/callback
# Request the read_orders (+ protected customer data) access for production stores.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# Optional overrides: comma-separated scopes (default read_orders,read_products)
# and Admin API version (default 2025-07).
SHOPIFY_SCOPES=""
SHOPIFY_API_VERSION=""

# ─── HubSpot ───
# developers.hubspot.com → create an app → Auth. Redirect URL:
# <APP_URL>/api/hubspot/callback. Scopes: oauth, crm.objects.contacts.read,
# crm.objects.deals.read.
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""

# ─── LinkedIn Ads ───
# developer.linkedin.com → create an app → request "Advertising API" access
# (Marketing Developer Platform — approval required; refresh tokens come with
# it). Auth redirect URL: <APP_URL>/api/linkedin/callback.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Optional: LinkedIn-Version header override (default 202609). LinkedIn retires each
# version about a year after release, so leave this unset unless pinning on purpose.
LINKEDIN_API_VERSION=""

# ─── TikTok Ads ───
# business-api.tiktok.com → TikTok for Business developer portal → create an
# app (approval required). Advertiser redirect URL: <APP_URL>/api/tiktok/callback.
# Scopes: Ad Account Management (read) + Reporting.
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

# ─── Pinterest Ads (Pinterest REST API v5) ───
# https://developers.pinterest.com → Apps → create an app (App ID + secret key).
# Requires a Pinterest business account; standard (non-trial) access needs app
# review to connect clients' accounts. Redirect URL: <APP_URL>/api/pinterest/callback.
# Scopes: ads:read + user_accounts:read (read-only).
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""

# ─── Snapchat Ads (Snapchat Marketing API v1) ───
# https://business.snapchat.com → Business Details → OAuth apps (or
# developers.snap.com). Redirect URL: <APP_URL>/api/snapchat/callback.
# Scope: snapchat-marketing-api (read-only reporting). Access token lives ~1h;
# the refresh token keeps sync running.
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""

# ─── Reddit Ads (Reddit Ads API v3) ───
# https://www.reddit.com/prefs/apps → create a "web app" (client id + secret).
# Reddit Ads API access is allow-list/approval gated — request Ads API access.
# Redirect URL: <APP_URL>/api/reddit/callback. Scope: adsread identity.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# ─── Amazon Ads (Amazon Advertising API v3) ───
# Login with Amazon app (developer.amazon.com) + Amazon Ads API access, which
# requires an application/approval. Redirect URL: <APP_URL>/api/amazon/callback.
# Scope: advertising::campaign_management. Reporting is async (create → poll).
# AMAZON_ADS_REGION: NA (default) | EU | FE — must match the account's region.
AMAZON_ADS_CLIENT_ID=""
AMAZON_ADS_CLIENT_SECRET=""
AMAZON_ADS_REGION="NA"

# ─── X Ads (X/Twitter Ads API v12) ───
# console.x.com → app → Keys and tokens (API Key + Secret; OAuth 1.0a signs them
# as the consumer key/secret, and the older X_ADS_CONSUMER_* names still work).
# Ads API access is granted per app via https://docs.x.com/forms/ads-api-access.
# Callback URL (register in the app): <APP_URL>/api/x/callback
X_ADS_CLIENT_KEY=""
X_ADS_CLIENT_SECRET=""

# ─── Adobe Analytics (Analytics 2.0 API) ───
# developer.adobe.com → project → add Adobe Analytics API → OAuth Web App
# credential. Requires an enterprise Adobe Analytics product profile.
# Redirect URI: <APP_URL>/api/adobe/callback
# Scopes: openid, AdobeID, read_organizations, additional_info.projectedProductContext
ADOBE_CLIENT_ID=""
ADOBE_CLIENT_SECRET=""

# ─── Salesforce (REST/SOQL API) ───
# Setup → App Manager → New Connected App → Enable OAuth. Callback URL:
# <APP_URL>/api/salesforce/callback. Scopes: api, refresh_token (offline access).
# SALESFORCE_LOGIN_URL: https://login.salesforce.com (default) or
# https://test.salesforce.com for sandboxes.
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SALESFORCE_LOGIN_URL=""

# ─── ActiveCampaign ───
# No app credentials needed — each agency connects a client by pasting that
# account's API URL + key (ActiveCampaign → Settings → Developer). Always live.

# ─── Constant Contact (v3 API) ───
# developer.constantcontact.com → My Applications → create an app (API key +
# secret). Redirect URI: <APP_URL>/api/constantcontact/callback
# Scopes: contact_data, campaign_data, offline_access (offline_access is required
# for the refresh token).
CONSTANT_CONTACT_CLIENT_ID=""
CONSTANT_CONTACT_CLIENT_SECRET=""

# ─── Campaign Monitor (API v3.3) ───
# campaignmonitor.com → Account settings → API keys / OAuth apps → register an
# app. Redirect URI: <APP_URL>/api/campaignmonitor/callback
# Scope: ViewReports (read-only).
CAMPAIGN_MONITOR_CLIENT_ID=""
CAMPAIGN_MONITOR_CLIENT_SECRET=""

# ─── AI report summaries (Anthropic) ───
# https://platform.claude.com → API keys. When set, every generated report gets a
# Claude-written executive summary, highlights, and recommendations. Leave blank to
# disable (reports still generate, just without the AI section).
ANTHROPIC_API_KEY=""
# Optional: override the model. Defaults to claude-opus-4-8 (most capable).
# Use claude-sonnet-4-6 or claude-haiku-4-5 to lower cost per report.
AI_MODEL=""

# ─── Email (Resend) ───
# https://resend.com → API keys. The key needs Full Access (not Sending only):
# agencies add and verify their own sending domains through the Resend Domains
# API from Email Branding in Settings.
#
# EMAIL_FROM is the PLATFORM fallback sender, used for every agency that hasn't
# completed white-label setup. Its domain must be verified in Resend. Agencies
# that verify their own domain send from their own address instead — see
# src/lib/email/sender.ts for the (security-critical) resolution rules.
RESEND_API_KEY=""
EMAIL_FROM="Anavyst <reports@yourdomain.com>"
# Optional default Reply-To when an agency hasn't set one.
EMAIL_REPLY_TO=""
# Optional: swap the delivery backend. Only "resend" is implemented today.
EMAIL_PROVIDER="resend"

# ─── Billing (Paddle Billing — Merchant of Record) ───
# https://paddle.com → sandbox first, then live. Steps:
#   1. Developer tools → Authentication → create an API key   → PADDLE_API_KEY
#   2. Developer tools → Authentication → client-side token   → PADDLE_CLIENT_TOKEN
#   3. Catalog → Products: one product per plan, each with a monthly and a
#      yearly price. Paste the PRICE ids (pri_…) below — not the product ids.
#   4. Developer tools → Notifications → new destination:
#        URL    <APP_URL>/api/webhooks/paddle
#        Events transaction.completed, subscription.created,
#               subscription.updated, subscription.canceled,
#               subscription.paused, subscription.resumed,
#               subscription.past_due
#      Copy the destination's secret key            → PADDLE_WEBHOOK_SECRET
# A plan appears in the pricing UI only once at least one of its price ids is
# set. Prices + client limits live in src/lib/billing/config.ts.
PADDLE_ENV="sandbox"                   # "sandbox" | "production" (anything else = sandbox)
PADDLE_API_KEY=""                      # server-side, secret
PADDLE_CLIENT_TOKEN=""                 # browser token for Paddle.js (publishable)
PADDLE_WEBHOOK_SECRET=""               # per-destination signing secret
# Plans (ascending client capacity): Pro, Pro Plus, Growth, Agency.
# AMOUNTS ARE NOT CONFIGURED HERE — they live in Paddle and the app reads them
# at runtime, so a price change in Paddle needs no deploy and the app can never
# advertise a figure Paddle won't charge. Only ids belong in this file.
# Either naming convention works; this deployment uses the _PRICE_ID form.
#
# The recurring interval is QUARTERLY (every 3 months). The legacy _YEARLY_ /
# _ANNUAL_ names are still read as a fallback, because the live environment
# repointed those variables at 3-month Paddle prices rather than renaming them.
# _QUARTERLY_ wins wherever both are set, so the environment can be renamed at
# any time with no code change.
PADDLE_PRO_MONTHLY_PRICE_ID=""
PADDLE_PRO_QUARTERLY_PRICE_ID=""
PADDLE_PRO_PLUS_MONTHLY_PRICE_ID=""
PADDLE_PRO_PLUS_QUARTERLY_PRICE_ID=""
PADDLE_GROWTH_MONTHLY_PRICE_ID=""
PADDLE_GROWTH_QUARTERLY_PRICE_ID=""
PADDLE_AGENCY_MONTHLY_PRICE_ID=""
PADDLE_AGENCY_QUARTERLY_PRICE_ID=""

# ─── Paid-plan trial (optional) ───
# Paddle attaches trials to the PRICE, not the checkout, so granting a trial to
# first-time customers while charging returning ones requires a second price
# per plan/interval carrying a trial period. Checkout picks between them using
# the one-time grant ledger (migration 0020), so nobody gets two trials.
#
# Create them with:  node scripts/create-trial-prices.mjs .env --apply
# Leave blank to disable the trial entirely — paid plans then charge
# immediately and no trial is advertised anywhere in the UI.
#
# These ids are candidates, not guarantees: checkout confirms the price is
# still active in Paddle before using it, and falls back to the standard price
# otherwise. If the standard price carries its own trial period, the customer
# still starts free — so an archived trial price degrades quietly rather than
# breaking the sale.
PADDLE_PRO_MONTHLY_TRIAL_PRICE_ID=""
PADDLE_PRO_QUARTERLY_TRIAL_PRICE_ID=""
PADDLE_PRO_PLUS_MONTHLY_TRIAL_PRICE_ID=""
PADDLE_PRO_PLUS_QUARTERLY_TRIAL_PRICE_ID=""
PADDLE_GROWTH_MONTHLY_TRIAL_PRICE_ID=""
PADDLE_GROWTH_QUARTERLY_TRIAL_PRICE_ID=""
PADDLE_AGENCY_MONTHLY_TRIAL_PRICE_ID=""
PADDLE_AGENCY_QUARTERLY_TRIAL_PRICE_ID=""

# Verify everything with: node scripts/verify-paddle.mjs .env

# ─── Billing (Lemon Squeezy — legacy, retained for historical rows only) ───
# No longer used for checkout. Safe to leave blank.
# https://lemonsqueezy.com → Settings → API. Create a Store, then a Product per
# plan with a monthly + annual Variant each; paste the variant IDs below.
# A plan only appears in the app when at least one of its variant IDs is set.
# Webhook: Settings → Webhooks → add <APP_URL>/api/billing/webhook with the
# subscription_* events; the signing secret goes in LEMONSQUEEZY_WEBHOOK_SECRET.
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
# Plans (create a Product per plan with monthly + annual variants). Prices +
# client limits live in src/lib/billing/config.ts; only variant IDs go here.
# A plan appears in the pricing UI only once at least one variant is set.
#   Pro       $54/mo  · up to 5 clients
#   Pro Plus  $108/mo · up to 10 clients
#   Growth    $164/mo · up to 25 clients
#   Agency    $329/mo · up to 50 clients
LEMONSQUEEZY_VARIANT_ID_PRO_MONTHLY=""
LEMONSQUEEZY_VARIANT_ID_PRO_ANNUAL=""
LEMONSQUEEZY_VARIANT_ID_PRO_PLUS_MONTHLY=""
LEMONSQUEEZY_VARIANT_ID_PRO_PLUS_ANNUAL=""
LEMONSQUEEZY_VARIANT_ID_GROWTH_MONTHLY=""
LEMONSQUEEZY_VARIANT_ID_GROWTH_ANNUAL=""
LEMONSQUEEZY_VARIANT_ID_AGENCY_MONTHLY=""
LEMONSQUEEZY_VARIANT_ID_AGENCY_ANNUAL=""
# Legacy names (still honored as Pro fallbacks):
# LEMONSQUEEZY_VARIANT_ID_MONTHLY / LEMONSQUEEZY_VARIANT_ID_ANNUAL

# ─── Scheduler ───
CRON_SECRET=""                         # server-only secret; cron routes require Authorization: Bearer <CRON_SECRET>

# ─── Background job tuning (optional; sensible defaults) ───
# Sync now uses a DISPATCHER that claims a large batch and fans it out to
# parallel worker invocations (/api/cron/sync-worker), so throughput scales
# horizontally instead of being capped by one 60s function.
#   SYNC_DISPATCH_LIMIT — total stalest sources claimed per cron tick (default 200)
#   SYNC_CHUNK_SIZE      — sources per parallel worker (default 25). Workers run
#                          concurrently, so ~DISPATCH_LIMIT/CHUNK_SIZE run at once.
# To scale further: raise SYNC_DISPATCH_LIMIT and/or the cron frequency.
SYNC_DISPATCH_LIMIT="200"
SYNC_CHUNK_SIZE="25"
# Legacy single-function batch size (still used by the fallback runSyncBatch path).
SYNC_BATCH_SIZE="25"
# Due schedules CLAIMED per /api/cron/reports run. Keep this to what one 60s run
# can actually finish: a job is a report generation (~15s when AI insights are
# on) plus a PDF render plus an email, and they run one after another. Claiming
# more than a run can reach strands the surplus — its schedule has already been
# advanced, so it survives only as a ledger row, and each re-claim spends one of
# its three retry attempts. Raise throughput with cron FREQUENCY (vercel.json),
# not with this number.
SCHEDULE_BATCH_SIZE="5"
# Wall-clock budget for starting new jobs in one run, inside the 60s limit.
SCHEDULE_RUN_BUDGET_MS="50000"
# metric_daily rows older than this are purged by the reports cron (retention).
METRIC_RETENTION_DAYS="400"

# ─── Error monitoring: Sentry (optional; recommended for launch) ───
# Set these to turn on error tracking. Unset = structured console logs only.
SENTRY_DSN=""                          # server DSN
NEXT_PUBLIC_SENTRY_DSN=""              # browser DSN (usually the same value)
SENTRY_ORG=""                          # for source-map upload at build time
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""                   # build-only; enables source maps
# SENTRY_TRACES_SAMPLE_RATE="0.1"      # optional perf sampling

# ─── Google Analytics 4 (traffic analytics) ───
# GA4 tag loads on all pages in production. Defaults to the configured property
# in code; override here if the measurement id changes.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XLPL33M3GH"

# ─── Product analytics: PostHog (optional; recommended for launch) ───
NEXT_PUBLIC_POSTHOG_KEY=""             # project API key (also used server-side)
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# POSTHOG_KEY=""                       # optional server-only key (falls back to the public one)

# ─── Integration honesty ───
# Allowlist of integration ids that are FULLY production-ready in THIS env
# (credentials configured + tested). Anything coded "live" but not listed shows
# "Coming soon" and can't be connected. Unset = all coded-live integrations show.
#   e.g. LIVE_INTEGRATIONS="gsc,ga4,meta_ads"
LIVE_INTEGRATIONS=""

# ─── Ops: maintenance & incidents ───
# MAINTENANCE_MODE="on"                # routes all traffic to /maintenance
# NEXT_PUBLIC_INCIDENT_MESSAGE="We're investigating slow report delivery."
# NEXT_PUBLIC_INCIDENT_LEVEL="warning" # info | warning | critical
# NEXT_PUBLIC_INCIDENT_URL="https://status.tryreportflow.com"
# CRON_STALE_HOURS="30"                # health check flags a cron stale after this

# ─── Affiliates (lib/affiliates, /dashboard/admin/affiliates) ───
ADMIN_EMAILS=""                       # comma-separated owner emails allowed into /dashboard/admin; empty = nobody
AFFILIATE_COOKIE_DAYS="60"            # how long the anavyst_ref referral cookie lasts
AFFILIATE_HOLD_DAYS="30"              # days before a commission becomes payable (covers the 14-day refund window)
